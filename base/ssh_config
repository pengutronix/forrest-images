# Use tpm2-pkcs11 if a TPM device is present and a store is set up
Match exec "test -e /dev/tpm0 -a -e ~/.tpm2_pkcs11"
  PKCS11Provider /usr/lib/x86_64-linux-gnu/pkcs11/libtpm2_pkcs11.so

Host ptxdist-cache
  Hostname 10.0.2.2
  User ptxdist-cache
  IdentityFile ~/.ssh/id_ed25519

Host yocto-cache
  Hostname 10.0.2.2
  User yocto-cache
  IdentityFile ~/.ssh/id_ed25519
